#!/bin/sh
# Auto-push the current branch to origin after every commit.
# Runs in the background so commits never block on the network.
# Installed by copying into <git-common-dir>/hooks (see README "Git hooks").
# Output goes to <git-common-dir>/auto-push.log; a vetoed push leaves <git-common-dir>/auto-push-failed.

# Clear hook-injected git env so our commands target the right worktree.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

git remote get-url origin >/dev/null 2>&1 || exit 0

branch=$(git symbolic-ref --short -q HEAD) || exit 0

# Temporary branches (parallel-wave task branches etc.) never go to origin.
case "$branch" in
  t/*|sa/*|tmp/*) exit 0 ;;
esac

sha=$(git rev-parse --short HEAD)
git_common_dir=$(git rev-parse --git-common-dir)
log="$git_common_dir/auto-push.log"
failed_marker="$git_common_dir/auto-push-failed"

(
  {
    echo "=== $(date '+%Y-%m-%dT%H:%M:%S%z') push $branch $sha"
    if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
      git push origin "$branch"
    else
      git push -u origin "$branch"
    fi
    code=$?
    echo "=== exit $code"
    if [ "$code" -ne 0 ]; then
      echo "$branch $sha $code" > "$failed_marker"
    else
      rm -f "$failed_marker"
    fi
  } >> "$log" 2>&1
) &
